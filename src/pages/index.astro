---
import Layout from '../layouts/Layout.astro';
import {
  profile,
  coreFocus,
  experience,
  technicalExpertise,
  education,
  certifications,
  publications,
} from '../data/resume';
---

<Layout title="Résumé">
  <!-- Hero -->
  <section class="pt-4 pb-10">
    <p class="eyebrow mb-3">Résumé — updated {new Date().getFullYear()}</p>
    <h1 class="font-display text-5xl sm:text-6xl leading-[1.05] tracking-tight">
      {profile.name}
    </h1>
    <p class="font-display italic text-xl sm:text-2xl text-ink-soft mt-2">
      {profile.title} · {profile.location}
    </p>
    <p class="mt-6 max-w-2xl text-[1.05rem] leading-relaxed text-ink-soft">
      {profile.summary}
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 eyebrow">
      {profile.links.map((link) => (
        <a href={link.url} class="hover:text-accent transition-colors underline decoration-accent-soft underline-offset-4">
          {link.label}
        </a>
      ))}
      <span class="text-ink-soft normal-case tracking-normal font-mono text-xs">{profile.phone}</span>
    </div>
  </section>

  <!-- Core focus -->
  <section class="ledger-rule pt-8 pb-2">
    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-5">
      {coreFocus.map((item) => (
        <li>
          <h3 class="font-display text-base text-ink">{item.title}</h3>
          <p class="text-sm text-ink-soft leading-relaxed mt-1">{item.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Experience -->
  <section class="ledger-rule pt-10 mt-8">
    <h2 class="eyebrow mb-8">Experience</h2>
    <ol class="relative pl-8">
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-rule" aria-hidden="true"></div>

      {experience.map((job) => (
        <li class="relative mb-10 last:mb-0">
          <span
            class="absolute -left-8 top-1.5 w-3.5 h-3.5 rounded-full bg-paper border-2 border-accent"
            aria-hidden="true"
          ></span>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="font-display text-xl">
              {job.role} <span class="text-ink-soft">· {job.org}</span>
            </h3>
            <span class="eyebrow whitespace-nowrap">{job.start} — {job.end}</span>
          </div>
          {job.client && <p class="text-sm text-ink-soft mt-0.5">Client — {job.client}</p>}
          <ul class="mt-3 space-y-1.5 text-ink-soft leading-relaxed">
            {job.highlights.map((h) => (
              <li class="flex gap-2">
                <span class="mt-2 block w-1 h-1 rounded-full bg-accent flex-shrink-0"></span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <!-- Technical expertise -->
  <section class="ledger-rule pt-10 mt-10">
    <h2 class="eyebrow mb-6">Technical Expertise</h2>
    <dl class="space-y-4">
      {technicalExpertise.map((group) => (
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-x-6 gap-y-1.5">
          <dt class="eyebrow w-36 flex-shrink-0">{group.category}</dt>
          <dd class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="text-sm font-mono px-2 py-0.5 bg-surface rounded-sm border border-rule">
                {item}
              </span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Education & Certifications -->
  <section class="ledger-rule pt-10 mt-10 grid sm:grid-cols-2 gap-10">
    <div>
      <h2 class="eyebrow mb-6">Education</h2>
      <div class="space-y-4">
        {education.map((ed) => (
          <div>
            <h3 class="font-display text-lg leading-snug">{ed.degree}</h3>
            <p class="text-sm text-ink-soft">{ed.school} · {ed.location}</p>
          </div>
        ))}
      </div>
    </div>
    <div>
      <h2 class="eyebrow mb-6">Certifications</h2>
      <ul class="space-y-2 text-sm text-ink-soft leading-relaxed">
        {certifications.map((c) => (
          <li class="flex gap-2">
            <span class="mt-1.5 block w-1 h-1 rounded-full bg-accent flex-shrink-0"></span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Publications -->
  <section class="ledger-rule pt-10 mt-10">
    <h2 class="eyebrow mb-6">Publications & Open Source</h2>
    <ul class="divide-y divide-rule">
      {publications.map((p) => (
        <li class="py-4 first:pt-0">
          <a href={p.url} class="group flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <span class="font-mono text-sm group-hover:text-accent transition-colors">{p.title}</span>
            <span class="text-sm text-ink-soft">{p.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
