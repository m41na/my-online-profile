---
import Layout from '../layouts/Layout.astro';
import SectionBand from '../components/SectionBand.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE_TARGET, isBusiness } from '../lib/site-target';

const practiceEntry = await getEntry('practice', SITE_TARGET);
if (!practiceEntry) {
  throw new Error(
    `Could not load the 'practice' data entry ('${SITE_TARGET}') from src/data/practice.yaml. ` +
      'This usually means a stale .astro cache — stop the dev server and run: ' +
      'rm -rf .astro node_modules/.vite && npm run dev'
  );
}
const { specializations, engagements, credentials, thesis, capabilities, ...practice } = practiceEntry.data;

const allCasework = await getCollection('casework', ({ data }) => data.status === 'live');
const casework = allCasework.sort((a, b) => a.data.order - b.data.order);

// Business site links case studies out to the personal site's full
// narrative write-ups rather than maintaining a second copy of those
// pages here — this stays a genuinely single page, not a shrunk clone
// of the multi-page personal site.
const caseworkHref = (id: string) => (isBusiness ? `https://smaina.kerbdrop.com/work/${id}/` : `/work/${id}/`);

// Simple monoline icons, one per specialization, in the same fixed order
// as the specializations array — business site only.
const serviceIcons = [
  'M12 3 2 8l10 5 10-5-10-5Z M2 13l10 5 10-5 M2 18l10 5 10-5',
  'M21 12a9 9 0 1 1-3-6.7 M21 4v5h-5',
  'M6 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z M18 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z M18 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z M7.5 11l9-3 M7.5 13l9 6',
  'M12 2v3 M12 19v3 M2 12h3 M19 12h3 M5.6 5.6l2 2 M16.4 16.4l2 2 M5.6 18.4l2-2 M16.4 7.6l2-2 M9 12a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z',
];
---

<Layout title="Platform Migration, Legacy Modernization & AI Integration">
  {isBusiness ? (
    <>
      <!-- Hero -->
      <SectionBand background="paper" class="relative overflow-hidden">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="relative">
          <h1 class="font-display font-semibold text-5xl sm:text-6xl leading-[1.05] tracking-tight">
            {practice.name}
          </h1>
          <p class="font-display text-xl sm:text-2xl text-accent mt-5">
            {practice.tagline}
          </p>
          <p class="mt-8 max-w-3xl text-[1.05rem] leading-relaxed text-ink-soft">
            {practice.positioning}
          </p>
          <a
            href="#contact"
            class="inline-block mt-8 font-mono text-sm px-5 py-2.5 rounded-full bg-accent text-paper hover:opacity-90 transition-opacity"
          >
            Get in touch
          </a>
        </div>
      </SectionBand>

      <!-- The pattern (thesis) -->
      <SectionBand background="paper">
        <p class="eyebrow mb-3">{thesis.eyebrow}</p>
        <h2 class="font-display font-semibold text-3xl sm:text-4xl leading-tight tracking-tight max-w-2xl">
          {thesis.heading}
        </h2>
        <p class="mt-4 max-w-2xl text-ink-soft leading-relaxed">
          {thesis.body}
        </p>
      </SectionBand>

      <!-- Services -->
      <SectionBand id="services" background="surface">
        <h2 class="eyebrow mb-8">Services</h2>
        <ul class="grid sm:grid-cols-2 gap-6">
          {specializations.map((item, i) => (
            <li class="panel panel-interactive !bg-paper px-6 py-6">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-accent mb-3">
                <path d={serviceIcons[i]}></path>
              </svg>
              <h3 class="font-display font-semibold text-lg text-ink">{item.title}</h3>
              <p class="text-sm text-ink-soft leading-relaxed mt-1.5">
                {item.detail} <span class="text-xs text-coral">(client — {item.client})</span>
              </p>
            </li>
          ))}
        </ul>
      </SectionBand>

      <!-- Case studies -->
      <SectionBand id="case-studies" background="paper">
        <h2 class="eyebrow mb-8">Case Studies</h2>
        <ol class="space-y-4">
          {casework.map((study, i) => (
            <li>
              <a href={caseworkHref(study.id)} class="panel panel-interactive group block px-6 py-6">
                <div class="flex items-baseline gap-4">
                  <span class="font-mono text-sm text-coral flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h3 class="font-display font-semibold text-2xl group-hover:text-accent transition-colors">
                        {study.data.title}
                      </h3>
                      <span class="eyebrow whitespace-nowrap">{study.data.sector}</span>
                    </div>
                    <p class="text-ink-soft mt-2 leading-relaxed">{study.data.hook}</p>
                    {(study.data.duration || study.data.teamSize || study.data.role) && (
                      <p class="eyebrow mt-2 text-ink-soft">
                        {[study.data.duration, study.data.teamSize && `Team of ${study.data.teamSize}`, study.data.role].filter(Boolean).join(' · ')}
                      </p>
                    )}
                    {study.data.stack.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-3">
                        {study.data.stack.map((tag) => (
                          <span class="text-xs font-mono px-2.5 py-1 bg-paper rounded-full border border-rule text-ink-soft">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                    <p class="eyebrow mt-3 text-moss">Read the full case study &rarr;</p>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </SectionBand>

      <!-- Why Kerbdrop -->
      {capabilities && (
        <SectionBand id="why-kerbdrop" background="surface">
          <h2 class="eyebrow mb-6">Why Kerbdrop</h2>
          <ul class="space-y-2 max-w-2xl">
            {capabilities.differentiators.map((item) => (
              <li class="flex gap-2 text-sm text-ink-soft leading-relaxed">
                <span class="text-coral flex-shrink-0">&bull;</span>{item}
              </li>
            ))}
          </ul>
        </SectionBand>
      )}

      <!-- Clients -->
      <SectionBand id="clients" background="paper">
        <h2 class="eyebrow mb-6">Clients</h2>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
          {engagements.map((e) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-sm">
              <span>
                <span class="text-ink">{e.org}</span>
                <span class="text-ink-soft"> — {e.note}</span>
              </span>
              <span class="eyebrow whitespace-nowrap flex-shrink-0">{e.years}</span>
            </li>
          ))}
        </ul>
        <p class="text-xs text-ink-soft mt-6">
          {credentials.yearsExperience} years across fintech, healthcare, insurance, and retail platforms ·
          {' '}{credentials.education.join(' · ')} ·
          {' '}{credentials.certifications.join(', ')}
        </p>
      </SectionBand>

      <!-- Contact — bold closing band -->
      <SectionBand id="contact" background="accent">
        <h2 class="eyebrow mb-4 !text-paper opacity-80">Get in touch</h2>
        <p class="text-paper leading-relaxed max-w-2xl opacity-95">
          Kerbdrop LLC is open to C2C subcontract and vendor-partnership engagements — platform
          migrations, legacy modernization, event-driven data platforms, and production AI integration.
          Reach out directly to discuss scope, rates, and available capacity.
        </p>
        <a
          href={`mailto:${practice.email}`}
          class="inline-block mt-5 font-mono text-sm px-5 py-2.5 rounded-full bg-paper text-accent hover:opacity-90 transition-opacity"
        >
          {practice.email}
        </a>
      </SectionBand>
    </>
  ) : (
    <>
      <!-- Hero -->
      <section class="relative pt-4 pb-14 overflow-hidden">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="relative px-6 sm:px-8">
          <p class="eyebrow mb-3">{practice.engagementModel}</p>
          <h1 class="font-display font-semibold text-5xl sm:text-6xl leading-[1.05] tracking-tight">
            {practice.name}
          </h1>
          <p class="font-display text-xl sm:text-2xl text-accent mt-3">
            {practice.tagline}
          </p>
          <p class="mt-6 text-[1.05rem] leading-relaxed text-ink-soft">
            {practice.positioning}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 eyebrow">
            {practice.links.map((link) => (
              <a href={link.url} class="hover:text-accent transition-colors underline decoration-accent-soft underline-offset-4">
                {link.label}
              </a>
            ))}
            <span class="text-ink-soft normal-case tracking-normal font-mono text-xs">{practice.principal}, {practice.principalTitle}</span>
          </div>
        </div>
      </section>

      <!-- The pattern (thesis) -->
      <section class="panel px-6 py-8 sm:px-8 sm:py-10 mt-6">
        <p class="eyebrow mb-3">{thesis.eyebrow}</p>
        <h2 class="font-display font-semibold text-3xl sm:text-4xl leading-tight tracking-tight">
          {thesis.heading}
        </h2>
        <p class="mt-4 text-ink-soft leading-relaxed">
          {thesis.body}
        </p>
      </section>

      <!-- Specializations -->
      <section id="services" class="mt-12 scroll-mt-8">
        <h2 class="eyebrow mb-6">Where I work</h2>
        <ul class="grid sm:grid-cols-2 gap-4">
          {specializations.map((item) => (
            <li class="panel panel-interactive px-5 py-5">
              <h3 class="font-display font-semibold text-lg text-ink">{item.title}</h3>
              <p class="text-sm text-ink-soft leading-relaxed mt-1.5">
                {item.detail} <span class="text-xs text-coral">(client — {item.client})</span>
              </p>
            </li>
          ))}
        </ul>
      </section>

      <!-- Case studies -->
      <section id="case-studies" class="mt-12 scroll-mt-8">
        <h2 class="eyebrow mb-6">Case files</h2>
        <ol class="space-y-4">
          {casework.map((study, i) => (
            <li>
              <a href={caseworkHref(study.id)} class="panel panel-interactive group block px-6 py-6">
                <div class="flex items-baseline gap-4">
                  <span class="font-mono text-sm text-coral flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h3 class="font-display font-semibold text-2xl group-hover:text-accent transition-colors">
                        {study.data.title}
                      </h3>
                      <span class="eyebrow whitespace-nowrap">{study.data.sector}</span>
                    </div>
                    <p class="text-ink-soft mt-2 leading-relaxed">{study.data.hook}</p>
                    {(study.data.duration || study.data.teamSize || study.data.role) && (
                      <p class="eyebrow mt-2 text-ink-soft">
                        {[study.data.duration, study.data.teamSize && `Team of ${study.data.teamSize}`, study.data.role].filter(Boolean).join(' · ')}
                      </p>
                    )}
                    {study.data.stack.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-3">
                        {study.data.stack.map((tag) => (
                          <span class="text-xs font-mono px-2.5 py-1 bg-paper rounded-full border border-rule text-ink-soft">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- Selected engagements -->
      <section class="panel px-6 py-8 sm:px-8 sm:py-10 mt-12">
        <h2 class="eyebrow mb-6">Selected engagements</h2>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
          {engagements.map((e) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-sm">
              <span>
                <span class="text-ink">{e.org}</span>
                <span class="text-ink-soft"> — {e.note}</span>
              </span>
              <span class="eyebrow whitespace-nowrap flex-shrink-0">{e.years}</span>
            </li>
          ))}
        </ul>
        <p class="text-xs text-ink-soft mt-6">
          {credentials.yearsExperience} years across fintech, healthcare, insurance, and retail platforms ·
          {' '}{credentials.education.join(' · ')} ·
          {' '}{credentials.certifications.join(', ')}
        </p>
      </section>

      <!-- Contact -->
      <section id="contact" class="mt-12 scroll-mt-8">
        <h2 class="eyebrow mb-4">Get in touch</h2>
        <p class="text-ink-soft leading-relaxed">
          A forced platform migration, a legacy system nobody wants to touch, a data platform that needs
          to serve five teams instead of one, an AI feature that has to actually hold up in production —
          if it's one of these, I'd rather hear about it directly than through a staffing layer.
        </p>
        <a
          href={`mailto:${practice.email}`}
          class="inline-block mt-5 font-mono text-sm px-5 py-2.5 rounded-full bg-accent text-paper hover:opacity-90 transition-opacity"
        >
          {practice.email}
        </a>
      </section>
    </>
  )}
</Layout>
