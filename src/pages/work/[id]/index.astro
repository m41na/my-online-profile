---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('casework', ({ data }) => data.status === 'live');
  return studies.map((study) => ({
    params: { id: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<Layout title={study.data.title} description={study.data.hook}>
  <article class="pt-4">
    <a href="/work" class="eyebrow hover:text-accent transition-colors">&larr; Case files</a>

    <header class="mt-6 mb-8">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span class="eyebrow text-coral">{study.data.sector}</span>
        {study.data.client && <span class="eyebrow text-ink-soft">· {study.data.client}</span>}
      </div>
      <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-[1.05] tracking-tight mt-3">
        {study.data.title}
      </h1>
      <p class="font-display text-lg text-ink-soft mt-3 max-w-2xl">{study.data.hook}</p>
      {study.data.stack.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {study.data.stack.map((tag) => (
            <span class="text-xs font-mono px-2.5 py-1 bg-surface rounded-full border border-rule text-ink-soft">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    {(study.data.duration || study.data.teamSize || study.data.role || study.data.outcome) && (
      <div class="panel mb-10 overflow-hidden">
        <dl class="grid sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-rule">
          {study.data.duration && (
            <div class="px-5 py-4">
              <dt class="eyebrow">Duration</dt>
              <dd class="font-display font-semibold text-lg mt-0.5">{study.data.duration}</dd>
            </div>
          )}
          {study.data.teamSize && (
            <div class="px-5 py-4">
              <dt class="eyebrow">Team</dt>
              <dd class="font-display font-semibold text-lg mt-0.5">{study.data.teamSize} people</dd>
            </div>
          )}
          {study.data.role && (
            <div class="px-5 py-4">
              <dt class="eyebrow">My role</dt>
              <dd class="font-display font-semibold text-lg mt-0.5">{study.data.role}</dd>
            </div>
          )}
        </dl>
        {study.data.outcome && (
          <div class="px-5 py-4 border-t border-rule">
            <dt class="eyebrow">Outcome</dt>
            <dd class="text-sm text-ink-soft leading-relaxed mt-1">{study.data.outcome}</dd>
          </div>
        )}
      </div>
    )}

    <div class="prose-ledger max-w-none prose prose-headings:font-display prose-headings:font-semibold prose-headings:tracking-tight prose-p:leading-relaxed prose-p:text-ink prose-a:no-underline prose-strong:text-ink prose-code:font-mono prose-code:text-sm prose-code:bg-surface prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </div>

    <div class="panel px-6 py-6 mt-10">
      <p class="text-ink-soft">Looking at a similar problem?</p>
      <a
        href="/#contact"
        class="inline-block mt-3 font-mono text-sm px-5 py-2.5 rounded-full bg-accent text-paper hover:opacity-90 transition-opacity"
      >
        Get in touch
      </a>
    </div>
  </article>
</Layout>
