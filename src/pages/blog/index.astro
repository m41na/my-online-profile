---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Notes" description="Notes on things I'm building and learning.">
  <section class="pt-4 pb-10 max-w-3xl mx-auto">
    <p class="eyebrow mb-3">Log</p>
    <h1 class="font-display font-semibold text-5xl leading-[1.05] tracking-tight">Notes</h1>
    <p class="mt-4 text-ink-soft leading-relaxed">
      Short write-ups on things I'm building, breaking, and learning.
    </p>
  </section>

  <section class="max-w-3xl mx-auto">
    {posts.length === 0 && (
      <p class="text-ink-soft italic">Nothing published yet — first entry coming soon.</p>
    )}
    <ul class="space-y-4">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="panel panel-interactive group block px-6 py-6">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-display font-semibold text-2xl group-hover:text-accent transition-colors">
                {post.data.title}
              </h2>
              <time class="eyebrow whitespace-nowrap" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            <p class="text-ink-soft mt-2 leading-relaxed">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="flex gap-2 mt-3">
                {post.data.tags.map((tag) => (
                  <span class="text-xs font-mono px-2.5 py-1 bg-paper rounded-full border border-rule text-ink-soft">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
